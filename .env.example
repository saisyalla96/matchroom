# Copy to .env (never commit .env)
MATCHROOM_BACKEND=foundry

# Microsoft Foundry / Azure OpenAI model deployment
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=matchroom-chat
AZURE_OPENAI_API_VERSION=2024-10-21
# Leave empty to use Entra ID (az login locally, managed identity in Azure)
AZURE_OPENAI_API_KEY=

# Optional: Azure AI Translator (otherwise the model translates)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus2
