# Copy to .env (never commit .env)
# offline | foundry (model directly) | agents (Foundry Agent Service, falls back to the model)
MATCHROOM_BACKEND=agents

# Microsoft Foundry / Azure OpenAI model deployment
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Leave empty to use Entra ID (az login locally, managed identity in Azure)
AZURE_OPENAI_API_KEY=

# Foundry project endpoint, for the agents backend (Entra ID sign-in: azd auth login / az login)
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Optional: send traces to Application Insights (Azure portal > Application Insights > Connection string)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional: Azure AI Translator (otherwise the model translates)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus2
